# ── AI Service ────────────────────────────────────────
AI_PORT=8000
MODEL_NAME=gpt-3.5-turbo
OPENAI_API_KEY=sk-...

# ── Frontend ──────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api/v1
