# ── Backend ──────────────────────────────────────────
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mindcare
JWT_SECRET=change_this_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
